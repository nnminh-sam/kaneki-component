{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "kaneki-components": ["../src/index.ts"],
      "kaneki-components/*": ["../src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
